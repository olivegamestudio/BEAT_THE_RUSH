<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <ApplicationId>com.ogs.signalbox</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="$(MonoGameVersion)" />
    <ProjectReference Include="../BeatTheRush.Core/BeatTheRush.Core.csproj" />
    <Compile Include="../BeatTheRush.Game/**/*.cs" LinkBase="Game" />
    <EmbeddedResource Include="../BeatTheRush.Game/Assets/*" LogicalName="Assets.%(Filename)%(Extension)" />
    <InterfaceDefinition Include="LaunchScreen.storyboard" />
  </ItemGroup>
</Project>

