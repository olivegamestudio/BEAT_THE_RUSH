<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
    <ProjectReference Include="../BeatTheRush.Core/BeatTheRush.Core.csproj" />
    <Compile Include="../BeatTheRush.Game/**/*.cs" LinkBase="Game" />
    <EmbeddedResource Include="../BeatTheRush.Game/Assets/*" LogicalName="Assets.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
